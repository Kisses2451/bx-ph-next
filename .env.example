# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=player-photos
# Cloudflare Turnstile site key (dash.cloudflare.com > Turnstile). Leave empty to switch the CAPTCHA off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only (never prefix these with NEXT_PUBLIC_)
# Turnstile secret key, used by app/api/apply/route.ts to verify the CAPTCHA.
TURNSTILE_SECRET_KEY=
# Supabase > Project Settings > API > service_role key. Lets /api/apply save applications after the database stops
# accepting them from browsers (supabase/migrations/20260923120000_require_server_submissions.sql).
SUPABASE_SERVICE_ROLE_KEY=
